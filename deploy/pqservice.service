[Unit]
Description=PQService FastAPI backend
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/WWW/proxy.pqnet.ru
EnvironmentFile=/etc/pqservice/pqservice.env
ExecStart=/var/WWW/proxy.pqnet.ru/.venv/bin/uvicorn backend.app:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/pqservice

[Install]
WantedBy=multi-user.target
