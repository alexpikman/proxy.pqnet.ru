3. public/api/routes/compat.php
Требование: calculateSubscriptionUrl читает секцию subscription из field_mapping.json.

Правка:

Вынести calculateSubscriptionUrl(array $user): ?string (если ещё не вынесена):

php
function calculateSubscriptionUrl(array $user): ?string
{
    $mapping = field_mapping_read();
    $config = $mapping['subscription'] ?? field_mapping_defaults()['subscription'];
    if (empty($config['enabled'])) {
        return null;
    }

    $connections = xui_connections_read();
    if (empty($connections)) {
        return null;
    }
    $conn = $connections[0];

    $scheme = $config['scheme'] === 'auto'
        ? (parse_url($conn['base_url'], PHP_URL_SCHEME) ?: 'https')
        : $config['scheme'];
    $host = $config['host'] === 'auto' || $config['host'] === 'connection_host'
        ? (parse_url($conn['base_url'], PHP_URL_HOST) ?: 'localhost')
        : $config['host'];

    $port = 0;
    $path = '';
    if ($config['source'] === 'panel_settings') {
        try {
            $client = xui_connection_client($conn);
            $settings = $client->request('POST', 'panel/api/setting/all');
            $obj = $settings['obj'] ?? [];
            if (empty($obj['subEnable'])) {
                return null;
            }
            $port = (int)($obj['subPort'] ?? 0);
            $path = trim((string)($obj['subPath'] ?? ''), '/');
        } catch (Throwable $e) {
            return null;
        }
    } elseif ($config['port_source'] === 'connection_port') {
        $port = (int)(parse_url($conn['base_url'], PHP_URL_PORT) ?? 0);
    }

    if ($port <= 0) {
        return null;
    }

    $subId = match ($config['sub_id_source']) {
        'xui.subId'    => (string)($user['sub_id'] ?? ''),
        'local.sub_id' => (string)($user['sub_id'] ?? ''),
        'login'        => (string)($user['login'] ?? ''),
        'uuid'         => (string)($user['uuid'] ?? ''),
        default        => '',
    };
    if ($subId === '') {
        return null;
    }

    $url = str_replace(
        ['{scheme}', '{host}', '{port}', '{path}', '{subId}'],
        [$scheme, $host, (string)$port, $path ? $path . '/' : '', rawurlencode($subId)],
        $config['url_template'] ?? '{scheme}://{host}:{port}/{path}{subId}'
    );
    return $url;
}
