{
    require_role('admin');
    $user = find_user_by_id($userId);
    if ($user === null) json_err('User not found.', 404);

    $connection = null;
    if (!empty($user['xui_connection_id'])) {
        $connection = xui_connection_find((string)$user['xui_connection_id']);
    }
    if ($connection === null) {
        $all = xui_connections_read();
        $connection = $all[0] ?? null;
    }
    if ($connection === null) json_err('No 3x-ui connection.', 409);

    $client = xui_connection_client($connection);
    $inboundId = (int)($user['xui_inbound_id'] ?? $user['inbound_id'] ?? 0);
    $uuid = (string)($user['xui_uuid'] ?? $user['uuid'] ?? '');
    if ($inboundId < 1 || $uuid === '') json_err('User not linked to 3x-ui.', 409);

    $remote = null;
    foreach ($client->getClients($inboundId) as $c) {
        if (isset($c['id']) && hash_equals($uuid, (string)$c['id'])) { $remote = $c; break; }
    }
    if ($remote === null) json_err('Client not found in 3x-ui.', 404);

    $updated = JsonStore::update('users.json', static function (&$users) use ($userId, $remote, $inboundId): array {
        $index = find_user_index($users, $userId);
        if ($index === null) throw new RuntimeException('User not found.');
        $users[$index]['email'] = $users[$index]['login'] = (string)($remote['email'] ?? $users[$index]['login']);
        $users[$index]['sub_id'] = (string)($remote['subId'] ?? '');
        $users[$index]['telegram_id'] = (string)($remote['tgId'] ?? '');
        $users[$index]['xui_enabled'] = (bool)($remote['enable'] ?? false);
        $users[$index]['inbound_id'] = $inboundId;
        $users[$index]['uuid'] = (string)$remote['id'];
        $users[$index]['updated_at'] = date(DATE_ATOM);
        return $users[$index];
    }, []);

    $subUrl = calculateSubscriptionUrl($updated);
    if ($subUrl !== null) {
        JsonStore::update('users.json', static function (&$users) use ($userId, $subUrl): void {
            $index = find_user_index($users, $userId);
            if ($index !== null) $users[$index]['subscription_url'] = $subUrl;
        });
        $updated['subscription_url'] = $subUrl;
    }
    json_ok(['user' => admin_public_user($updated)]);
}

function route_admin_user_hard_delete(string $userId): never
{
    require_role('admin');
    JsonStore::update('users.json', static function (&$users) use ($userId): void {
        foreach ($users as $index => $u) {
            if (is_array($u) && (string)($u['id'] ?? '') === $userId) {
                unset($users[$index]);
                $users = array_values($users);
                return;
            }
        }
        throw new RuntimeException('User not found.');
    }, []);
    json_ok(['deleted' => true]);
}

function route_admin_users_refresh_all_subscriptions(): never
{
    require_role('admin');
    $updated = 0; $total = 0; $errors = [];
    JsonStore::update('users.json', static function (&$users) use (&$updated, &$total, &$errors): void {
        foreach ($users as $index => $u) {
            if (!is_array($u) || !empty($u['deleted'])) continue;
            $total++;
            try {
                $url = calculateSubscriptionUrl($u);
                if ($url !== null && ($u['subscription_url'] ?? null) !== $url) {
                    $users[$index]['subscription_url'] = $url;
                    $users[$index]['updated_at'] = date(DATE_ATOM);
                    $updated++;
                }
            } catch (Throwable $e) {
                $errors[] = ['user_id' => $u['id'] ?? '', 'message' => $e->getMessage()];
            }
        }
    });
    json_ok(['updated' => $updated, 'total' => $total, 'errors' => $errors]);
}

function route_admin_subscription_config(): never
{
    require_role('admin');
    $mapping = field_mapping_read();
    $connections = xui_connections_read();
    $base = $connections[0]['base_url'] ?? null;
    $scheme = $base ? parse_url($base, PHP_URL_SCHEME) : 'https';
    $host = $base ? parse_url($base, PHP_URL_HOST) : '';
    $port = 0;
    try {
        if ($base) {
            $client = xui_connection_client($connections[0]);
            $settings = $client->request('POST', 'panel/api/setting/all');
            $port = (int)($settings['obj']['subPort'] ?? 0);
        }
    } catch (Throwable $e) {}
    json_ok([
        'scheme' => $scheme, 'host' => $host, 'port' => $port,
        'base_url' => $base, 'field_mapping' => $mapping,
    ]);
}

